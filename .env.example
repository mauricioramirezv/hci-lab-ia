# Optional secure server-side proxy. Never place a provider API key in VITE_* variables.
VITE_AI_PROXY_URL=
# Same-origin development proxies preserve cookies when using localhost or 127.0.0.1.
# Production static hosting must configure HTTPS API URLs and backend CORS/cookies.
VITE_IDENTITY_API_URL=/api/identity
VITE_LEARNING_API_URL=/api/learning
VITE_COMMUNITY_API_URL=/api/community
VITE_EVIDENCE_API_URL=/api/evidence
